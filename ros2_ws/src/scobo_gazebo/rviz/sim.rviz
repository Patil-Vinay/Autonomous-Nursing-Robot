Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frames:
        All Enabled: false
        base_footprint:
          Value: true
        thermal_link:
          Value: true
        camera_link:
          Value: true
        odom:
          Value: true
      Marker Scale: 0.5
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Wheel Odometry
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 255; 25; 0
        Alpha: 1
        Shaft Length: 0.3
        Shaft Radius: 0.02
        Head Length: 0.08
        Head Radius: 0.05
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: EKF Odometry
      Enabled: true
      Topic:
        Value: /odometry/filtered
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 0; 170; 255
        Alpha: 1
        Shaft Length: 0.3
        Shaft Radius: 0.02
        Head Length: 0.08
        Head Radius: 0.05
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Range
      Name: Ultrasonic Rear
      Enabled: true
      Topic:
        Value: /range/rear
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Color: 255; 200; 0
      Alpha: 0.5
      Buffer Length: 1
      Value: true
    - Class: rviz_default_plugins/Range
      Name: Ultrasonic Front
      Enabled: true
      Topic:
        Value: /range/front
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Color: 255; 200; 0
      Alpha: 0.5
      Buffer Length: 1
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Alpha: 1
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Webcam
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Thermal
      Enabled: true
      Topic:
        Value: /thermal/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.7
      Yaw: 2.4
      Target Frame: base_footprint
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
