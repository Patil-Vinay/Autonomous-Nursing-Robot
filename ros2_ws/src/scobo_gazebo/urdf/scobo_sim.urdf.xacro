<?xml version="1.0"?>
<robot name="scobo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- SCOBO description with the Gazebo plugins and sensors -->
  <xacro:arg name="mesh_dir" default="file://$(find scobo_description)/meshes"/>
  <xacro:include filename="$(find scobo_description)/urdf/scobo.urdf.xacro"/>

  <!-- also given to wheel_odometry in sim.launch.py -->
  <xacro:property name="wheel_radius_sim" value="0.0482"/>
  <xacro:property name="wheel_separation_sim" value="0.3179"/>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <!-- held level by pan_tilt_controller -->
    <joint name="display_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="display_tilt_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </ros2_control>

  <xacro:macro name="wheel_slip" params="name">
    <wheel link_name="${name}_wheel">
      <slip_compliance_lateral>3.0</slip_compliance_lateral>
      <slip_compliance_longitudinal>0.0</slip_compliance_longitudinal>
      <wheel_normal_force>${robot_mass * 9.81 / 4}</wheel_normal_force>
    </wheel>
  </xacro:macro>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find scobo_gazebo)/config/controllers.yaml</parameters>
    </plugin>

    <!-- 4WD skid steer on cmd_vel, 2.4 Nm per wheel. Effective track 1.12 x 0.2838 m
         as the wheels slip in turns. Odometry comes from wheel_odometry -->
    <plugin filename="libgazebo_ros_diff_drive.so" name="diff_drive">
      <update_rate>100</update_rate>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation_sim}</wheel_separation>
      <wheel_separation>${wheel_separation_sim}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius_sim}</wheel_diameter>
      <wheel_diameter>${2 * wheel_radius_sim}</wheel_diameter>
      <max_wheel_torque>2.4</max_wheel_torque>
      <max_wheel_acceleration>0.5</max_wheel_acceleration>
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>

    <!-- encoder angles for wheel_odometry and robot_state_publisher -->
    <plugin filename="libgazebo_ros_joint_state_publisher.so" name="wheel_states">
      <update_rate>50</update_rate>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>

    <!-- sideways tyre compliance for skid steer turns -->
    <plugin filename="libWheelSlipPlugin.so" name="wheel_slip">
      <xacro:wheel_slip name="front_left"/>
      <xacro:wheel_slip name="rear_left"/>
      <xacro:wheel_slip name="front_right"/>
      <xacro:wheel_slip name="rear_right"/>
    </plugin>

    <!-- true pose, to check odometry -->
    <plugin filename="libgazebo_ros_p3d.so" name="ground_truth">
      <ros>
        <remapping>odom:=ground_truth</remapping>
      </ros>
      <body_name>base_footprint</body_name>
      <frame_name>world</frame_name>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- fdir1 is the axle, so mu1 is the sideways grip -->
  <xacro:macro name="wheel_contact" params="name">
    <gazebo reference="${name}_wheel">
      <fdir1>0 0 1</fdir1>
      <mu1>0.3</mu1>
      <mu2>0.8</mu2>
      <kp>1e6</kp>
      <kd>100</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_contact name="front_left"/>
  <xacro:wheel_contact name="rear_left"/>
  <xacro:wheel_contact name="front_right"/>
  <xacro:wheel_contact name="rear_right"/>

  <!-- RPLidar A1, the frame posts behind it block the rear so only 260 deg is used -->
  <xacro:property name="laser_half_fov" value="130"/>
  <xacro:property name="laser_step" value="0.5"/>

  <gazebo reference="laser">
    <sensor name="rplidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>5.5</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>${int(2 * laser_half_fov / laser_step) + 1}</samples>
            <resolution>1</resolution>
            <min_angle>${-radians(laser_half_fov)}</min_angle>
            <max_angle>${radians(laser_half_fov)}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="rplidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- BNO055, noise from the datasheet noise densities -->
  <xacro:macro name="imu_noise" params="stddev bias">
    <noise type="gaussian">
      <mean>0.0</mean>
      <stddev>${stddev}</stddev>
      <bias_mean>0.0</bias_mean>
      <bias_stddev>${bias}</bias_stddev>
    </noise>
  </xacro:macro>
  <xacro:property name="gyro_stddev" value="${radians(0.014) * sqrt(50)}"/>
  <xacro:property name="gyro_bias" value="0.0003"/>
  <xacro:property name="accel_stddev" value="${150e-6 * 9.81 * sqrt(50)}"/>
  <xacro:property name="accel_bias" value="0.01"/>

  <gazebo reference="imu_link">
    <sensor name="bno055" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x><xacro:imu_noise stddev="${gyro_stddev}" bias="${gyro_bias}"/></x>
          <y><xacro:imu_noise stddev="${gyro_stddev}" bias="${gyro_bias}"/></y>
          <z><xacro:imu_noise stddev="${gyro_stddev}" bias="${gyro_bias}"/></z>
        </angular_velocity>
        <linear_acceleration>
          <x><xacro:imu_noise stddev="${accel_stddev}" bias="${accel_bias}"/></x>
          <y><xacro:imu_noise stddev="${accel_stddev}" bias="${accel_bias}"/></y>
          <z><xacro:imu_noise stddev="${accel_stddev}" bias="${accel_bias}"/></z>
        </linear_acceleration>
      </imu>
      <plugin name="bno055" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- HC-SR04, 6 cm above the floor so only the upper half of the cone is used -->
  <xacro:property name="sonar_half_fov" value="${radians(7.5)}"/>

  <gazebo reference="ultrasonic_link">
    <sensor name="hc_sr04" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>7</samples>
            <resolution>1</resolution>
            <min_angle>${-sonar_half_fov}</min_angle>
            <max_angle>${sonar_half_fov}</max_angle>
          </horizontal>
          <vertical>
            <samples>4</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>${sonar_half_fov}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.003</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="hc_sr04" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=range_sim</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <radiation_type>ultrasound</radiation_type>
        <frame_name>ultrasonic_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="base_footprint">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

</robot>
