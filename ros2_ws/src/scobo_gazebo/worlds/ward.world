<?xml version="1.0"?>
<sdf version="1.6">
  <!-- 8-bed ward, 18 x 8 m inside. Beds 1-4 along the north wall from the door,
       5-8 back along the south wall. -->
  <world name="ward">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <gui>
      <camera name="overview">
        <pose>0 -11 12 0 0.85 1.5708</pose>
      </camera>
    </gui>

    <model name="floor">
      <static>true</static>
      <pose>0 0 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>18 8 0.001</size></box></geometry>
          <material>
            <ambient>0.78 0.8 0.74 1</ambient>
            <diffuse>0.78 0.8 0.74 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 4.05 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>18.2 0.1 2.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>18.2 0.1 2.6</size></box></geometry>
          <material>
            <ambient>0.93 0.92 0.88 1</ambient>
            <diffuse>0.93 0.92 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.05 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>18.2 0.1 2.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>18.2 0.1 2.6</size></box></geometry>
          <material>
            <ambient>0.93 0.92 0.88 1</ambient>
            <diffuse>0.93 0.92 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>9.05 0 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 8.0 2.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 8.0 2.6</size></box></geometry>
          <material>
            <ambient>0.93 0.92 0.88 1</ambient>
            <diffuse>0.93 0.92 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-9.05 0 1.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 8.0 2.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 8.0 2.6</size></box></geometry>
          <material>
            <ambient>0.93 0.92 0.88 1</ambient>
            <diffuse>0.93 0.92 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="door">
      <static>true</static>
      <pose>-8.995 0 1.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.01 1.6 2.1</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.28 1</ambient>
            <diffuse>0.55 0.4 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- bed 1 -->
    <include>
      <name>bed_1</name>
      <uri>model://hospital_bed</uri>
      <pose>-4.5 2.9 0 0 0 -1.5708</pose>
    </include>
    <include>
      <name>locker_1</name>
      <uri>model://bedside_locker</uri>
      <pose>-3.65 3.7 0 0 0 -1.5708</pose>
    </include>

    <!-- bed 2 -->
    <include>
      <name>bed_2</name>
      <uri>model://hospital_bed</uri>
      <pose>-1.5 2.9 0 0 0 -1.5708</pose>
    </include>
    <include>
      <name>locker_2</name>
      <uri>model://bedside_locker</uri>
      <pose>-0.65 3.7 0 0 0 -1.5708</pose>
    </include>

    <!-- bed 3 -->
    <include>
      <name>bed_3</name>
      <uri>model://hospital_bed</uri>
      <pose>1.5 2.9 0 0 0 -1.5708</pose>
    </include>
    <include>
      <name>locker_3</name>
      <uri>model://bedside_locker</uri>
      <pose>2.35 3.7 0 0 0 -1.5708</pose>
    </include>

    <!-- bed 4 -->
    <include>
      <name>bed_4</name>
      <uri>model://hospital_bed</uri>
      <pose>4.5 2.9 0 0 0 -1.5708</pose>
    </include>
    <include>
      <name>locker_4</name>
      <uri>model://bedside_locker</uri>
      <pose>5.35 3.7 0 0 0 -1.5708</pose>
    </include>

    <!-- bed 5 -->
    <include>
      <name>bed_5</name>
      <uri>model://hospital_bed</uri>
      <pose>4.5 -2.9 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>locker_5</name>
      <uri>model://bedside_locker</uri>
      <pose>5.35 -3.7 0 0 0 1.5708</pose>
    </include>

    <!-- bed 6 -->
    <include>
      <name>bed_6</name>
      <uri>model://hospital_bed</uri>
      <pose>1.5 -2.9 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>locker_6</name>
      <uri>model://bedside_locker</uri>
      <pose>2.35 -3.7 0 0 0 1.5708</pose>
    </include>

    <!-- bed 7 -->
    <include>
      <name>bed_7</name>
      <uri>model://hospital_bed</uri>
      <pose>-1.5 -2.9 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>locker_7</name>
      <uri>model://bedside_locker</uri>
      <pose>-0.65 -3.7 0 0 0 1.5708</pose>
    </include>

    <!-- bed 8 -->
    <include>
      <name>bed_8</name>
      <uri>model://hospital_bed</uri>
      <pose>-4.5 -2.9 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>locker_8</name>
      <uri>model://bedside_locker</uri>
      <pose>-3.65 -3.7 0 0 0 1.5708</pose>
    </include>

    <!-- nurse station and medicine trolley -->
    <model name="nurse_station">
      <static>true</static>
      <pose>8.6 2.45 0.525 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 2.9 1.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 2.9 1.05</size></box></geometry>
          <material>
            <ambient>0.45 0.6 0.75 1</ambient>
            <diffuse>0.45 0.6 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="medicine_trolley">
      <static>true</static>
      <pose>8.65 -2.2 0.475 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.45 0.6 0.95</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.6 0.95</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.88 1</ambient>
            <diffuse>0.85 0.85 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
