<?xml version="1.0"?>
<sdf version="1.6">
  <!-- 2.1 x 1.0 m bed, head end at -x, backrest and side rails raised -->
  <model name="hospital_bed">
    <static>true</static>
    <link name="link">

      <collision name="frame">
        <pose>0 0 0.30 0 0 0</pose>
        <geometry><box><size>2.0 0.9 0.30</size></box></geometry>
      </collision>
      <visual name="frame">
        <pose>0 0 0.30 0 0 0</pose>
        <geometry><box><size>2.0 0.9 0.30</size></box></geometry>
        <material>
          <ambient>0.6 0.62 0.65 1</ambient>
          <diffuse>0.6 0.62 0.65 1</diffuse>
        </material>
      </visual>

      <collision name="mattress">
        <pose>0.39 0 0.53 0 0 0</pose>
        <geometry><box><size>1.18 0.88 0.16</size></box></geometry>
      </collision>
      <visual name="mattress">
        <pose>0.39 0 0.53 0 0 0</pose>
        <geometry><box><size>1.18 0.88 0.16</size></box></geometry>
        <material>
          <ambient>0.8 0.88 0.95 1</ambient>
          <diffuse>0.8 0.88 0.95 1</diffuse>
        </material>
      </visual>

      <!-- head section raised 25 deg, hinged at the top of the mattress at x -0.2 -->
      <collision name="backrest">
        <pose>-0.587 0 0.702 0 0.4363 0</pose>
        <geometry><box><size>0.78 0.88 0.16</size></box></geometry>
      </collision>
      <visual name="backrest">
        <pose>-0.587 0 0.702 0 0.4363 0</pose>
        <geometry><box><size>0.78 0.88 0.16</size></box></geometry>
        <material>
          <ambient>0.8 0.88 0.95 1</ambient>
          <diffuse>0.8 0.88 0.95 1</diffuse>
        </material>
      </visual>
      <visual name="blanket">
        <pose>0.25 0 0.62 0 0 0</pose>
        <geometry><box><size>1.3 0.9 0.03</size></box></geometry>
        <material>
          <ambient>0.35 0.55 0.75 1</ambient>
          <diffuse>0.35 0.55 0.75 1</diffuse>
        </material>
      </visual>

      <collision name="headboard">
        <pose>-1.025 0 0.55 0 0 0</pose>
        <geometry><box><size>0.05 1.0 0.9</size></box></geometry>
      </collision>
      <visual name="headboard">
        <pose>-1.025 0 0.55 0 0 0</pose>
        <geometry><box><size>0.05 1.0 0.9</size></box></geometry>
        <material>
          <ambient>0.55 0.4 0.28 1</ambient>
          <diffuse>0.55 0.4 0.28 1</diffuse>
        </material>
      </visual>

      <collision name="footboard">
        <pose>1.025 0 0.475 0 0 0</pose>
        <geometry><box><size>0.05 1.0 0.75</size></box></geometry>
      </collision>
      <visual name="footboard">
        <pose>1.025 0 0.475 0 0 0</pose>
        <geometry><box><size>0.05 1.0 0.75</size></box></geometry>
        <material>
          <ambient>0.55 0.4 0.28 1</ambient>
          <diffuse>0.55 0.4 0.28 1</diffuse>
        </material>
      </visual>

      <collision name="rail_head_left">
        <pose>-0.5 0.475 0.75 0 0 0</pose>
        <geometry><box><size>0.85 0.03 0.34</size></box></geometry>
      </collision>
      <visual name="rail_head_left">
        <pose>-0.5 0.475 0.75 0 0 0</pose>
        <geometry><box><size>0.85 0.03 0.34</size></box></geometry>
        <material>
          <ambient>0.75 0.75 0.78 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
        </material>
      </visual>

      <collision name="rail_foot_left">
        <pose>0.5 0.475 0.75 0 0 0</pose>
        <geometry><box><size>0.85 0.03 0.34</size></box></geometry>
      </collision>
      <visual name="rail_foot_left">
        <pose>0.5 0.475 0.75 0 0 0</pose>
        <geometry><box><size>0.85 0.03 0.34</size></box></geometry>
        <material>
          <ambient>0.75 0.75 0.78 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
        </material>
      </visual>

      <collision name="rail_head_right">
        <pose>-0.5 -0.475 0.75 0 0 0</pose>
        <geometry><box><size>0.85 0.03 0.34</size></box></geometry>
      </collision>
      <visual name="rail_head_right">
        <pose>-0.5 -0.475 0.75 0 0 0</pose>
        <geometry><box><size>0.85 0.03 0.34</size></box></geometry>
        <material>
          <ambient>0.75 0.75 0.78 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
        </material>
      </visual>

      <collision name="rail_foot_right">
        <pose>0.5 -0.475 0.75 0 0 0</pose>
        <geometry><box><size>0.85 0.03 0.34</size></box></geometry>
      </collision>
      <visual name="rail_foot_right">
        <pose>0.5 -0.475 0.75 0 0 0</pose>
        <geometry><box><size>0.85 0.03 0.34</size></box></geometry>
        <material>
          <ambient>0.75 0.75 0.78 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>
